# Monitoring and setpoint control for one MUSIC field cage.
#
# i.keshelashvili@gsi.de
#
# P      EPICS prefix, e.g. SFRS:FHF1:MUSIC1:
# FC     field-cage number, 1..4
# PORT   asyn port name
# BD     two-digit CAEN local-bus address
# CH     CAEN channel, 0..3
# VMAX   maximum voltage accepted through EPICS, volts
# IMAX   maximum current limit accepted through EPICS, microamperes

record(bo, "$(P)FC$(FC):PHV:ENABLE")
{
    field(DESC, "HV output enable")
    field(DTYP, "stream")
    field(OUT,  "@caen_n1410.proto setEnable($(BD),$(CH)) $(PORT)")

    field(ZNAM, "OFF")
    field(ONAM, "ON")

    # Never automatically energize HV when the IOC starts.
    field(PINI, "NO")
}

record(longin, "$(P)FC$(FC):PHV:STATUS")
{
    field(DESC, "Raw CAEN status bitmask")
    field(DTYP, "stream")
    field(INP,  "@caen_n1410.proto getStatus($(BD),$(CH)) $(PORT)")
    field(SCAN, "1 second")
}

record(ao, "$(P)FC$(FC):PHV:V_SET")
{
    field(DESC, "HV voltage setpoint")
    field(DTYP, "stream")
    field(OUT,  "@caen_n1410.proto setVSet($(BD),$(CH)) $(PORT)")
    field(SCAN, "Passive")
    field(EGU,  "V")
    field(PREC, "2")
    field(DRVL, "0")
    field(DRVH, "$(VMAX)")
    field(LOPR, "0")
    field(HOPR, "$(VMAX)")
    field(PINI, "NO")
}

record(ai, "$(P)FC$(FC):PHV:V_RBV")
{
    field(DESC, "Measured HV voltage")
    field(DTYP, "stream")
    field(INP,  "@caen_n1410.proto getVMon($(BD),$(CH)) $(PORT)")
    field(SCAN, "1 second")
    field(EGU,  "V")
    field(PREC, "2")
    field(HOPR, "$(VMAX)")
    field(LOPR, "-1")
}

record(ao, "$(P)FC$(FC):PHV:I_SET")
{
    field(DESC, "HV current-limit setpoint")
    field(DTYP, "stream")
    field(OUT,  "@caen_n1410.proto setISet($(BD),$(CH)) $(PORT)")
    field(SCAN, "Passive")
    field(EGU,  "uA")
    field(PREC, "3")
    field(DRVL, "0")
    field(DRVH, "$(IMAX)")
    field(LOPR, "0")
    field(HOPR, "$(IMAX)")
    field(PINI, "NO")
}

record(ai, "$(P)FC$(FC):PHV:I_RBV")
{
    field(DESC, "Measured HV current")
    field(DTYP, "stream")
    field(INP,  "@caen_n1410.proto getIMon($(BD),$(CH)) $(PORT)")
    field(SCAN, "1 second")
    field(EGU,  "uA")
    field(PREC, "4")
    field(HOPR, "$(IMAX)")
    field(LOPR, "-1")
}

record(ao, "$(P)FC$(FC):PHV:RAMP_UP_SET")
{
    field(DESC, "HV ramp-up speed")
    field(DTYP, "stream")
    field(OUT,  "@caen_n1410.proto setRampUp($(BD),$(CH)) $(PORT)")

    field(EGU,  "V/s")
    field(PREC, "0")
    field(DRVL, "1")
    field(DRVH, "100")
    field(LOPR, "1")
    field(HOPR, "100")

    field(PINI, "NO")
}

record(ao, "$(P)FC$(FC):PHV:RAMP_DOWN_SET")
{
    field(DESC, "HV ramp-down speed")
    field(DTYP, "stream")
    field(OUT,  "@caen_n1410.proto setRampDown($(BD),$(CH)) $(PORT)")

    field(EGU,  "V/s")
    field(PREC, "0")
    field(DRVL, "1")
    field(DRVH, "100")
    field(LOPR, "1")
    field(HOPR, "100")

    field(PINI, "NO")
}

# Readable polarity aliases; each name refers to the same EPICS record.
alias("$(P)FC$(FC):PHV:ENABLE", "$(P)FC$(FC):POSITIVE:ENABLE")
alias("$(P)FC$(FC):PHV:STATUS", "$(P)FC$(FC):POSITIVE:STATUS")
alias("$(P)FC$(FC):PHV:V_SET", "$(P)FC$(FC):POSITIVE:V_SET")
alias("$(P)FC$(FC):PHV:V_RBV", "$(P)FC$(FC):POSITIVE:V_RBV")
alias("$(P)FC$(FC):PHV:I_SET", "$(P)FC$(FC):POSITIVE:I_SET")
alias("$(P)FC$(FC):PHV:I_RBV", "$(P)FC$(FC):POSITIVE:I_RBV")
alias("$(P)FC$(FC):PHV:RAMP_UP_SET", "$(P)FC$(FC):POSITIVE:RAMP_UP_SET")
alias("$(P)FC$(FC):PHV:RAMP_DOWN_SET", "$(P)FC$(FC):POSITIVE:RAMP_DOWN_SET")
